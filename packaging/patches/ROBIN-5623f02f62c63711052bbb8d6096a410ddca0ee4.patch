--- a/include/robin/platform_atomic.hpp
+++ b/include/robin/platform_atomic.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#if defined(_MSC_VER)
+#include <intrin.h>
+#endif
+namespace robin {
+template <typename T, typename V> T platformFetchAdd(T* address, V value) {
+#if defined(_MSC_VER)
+  if constexpr (sizeof(T) == 8)
+    return static_cast<T>(_InterlockedExchangeAdd64(reinterpret_cast<volatile long long*>(address), static_cast<long long>(value)));
+  else
+    return static_cast<T>(_InterlockedExchangeAdd(reinterpret_cast<volatile long*>(address), static_cast<long>(value)));
+#else
+  return __sync_fetch_and_add(address, value);
+#endif
+}
+template <typename T, typename V> T platformFetchSub(T* address, V value) {
+  return platformFetchAdd(address, -static_cast<T>(value));
+}
+}
