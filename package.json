{
  "name": "lyflow",
  "private": true,
  "version": "2.0.4",
  "lyflowEngineVersion": "2.0.4",
  "packageManager": "pnpm@12.4.2",
  "description": "通用 Vision Flow：节点图编排点云/图像算子，图在前端编辑，计算在 C++ 执行",
  "scripts": {
    "format": "prettier --write \"{app,packages,examples}/**/*.{js,cjs,mjs,ts,tsx,jsx,css,html,json}\" package.json pnpm-workspace.yaml .github .prettierrc.json",
    "format:check": "prettier --check \"{app,packages,examples}/**/*.{js,cjs,mjs,ts,tsx,jsx,css,html,json}\" package.json pnpm-workspace.yaml .github .prettierrc.json",
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "app:dev": "pnpm --filter lyflow-app dev",
    "sdk:restore": "pwsh -NoProfile -File scripts/restore-native-sdk.ps1 -Destination build/native-sdk",
    "typecheck": "pnpm --filter @lyflow/editor typecheck && pnpm --filter lyflow-app typecheck",
    "cli:build": "cargo build --release --manifest-path bridge/Cargo.toml --bin lyflow --no-default-features",
    "package": "pwsh -NoProfile -File scripts/package-windows.ps1",
    "check": "pwsh -NoProfile -File scripts/check.ps1",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:packaged": "node scripts/e2e/run.mjs --packaged",
    "e2e:http": "node scripts/e2e/http.mjs",
    "test-server": "node packages/editor/test-server/server.mjs",
    "host:dev": "pnpm --filter lyflow-host-react dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "prettier": "3.6.2"
  }
}
