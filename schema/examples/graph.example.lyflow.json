  "groups": [],
  "subgraphs": {
    "sg_clean": {
      "name": "去噪",
      "doc": "体素降采样 + 统计离群点剔除。leafSize 提升成对外参数。",
      "category": "Cleanup",
      "version": "1.0.0",
      "nodes": [
        {
          "id": "s_voxel",
          "op": "filter.voxel_grid",
          "opVersion": "1.0.0",
          "params": {},
          "ui": {
            "position": {
              "x": 0,
              "y": 0
            }
          }
        },
        {
          "id": "s_sor",
          "op": "filter.statistical_outlier",
          "opVersion": "1.0.0",
          "params": {
            "meanK": 20
          },
          "ui": {
            "position": {
              "x": 260,
              "y": 0
            }
          }
        }
      ],
      "edges": [
        {
          "id": "s_e1",
          "from": {
            "node": "s_voxel",
            "port": "cloud"
          },
          "to": {
            "node": "s_sor",
            "port": "cloud"
          }
        }
      ],
      "inputs": [
        {
          "name": "cloud",
          "type": "PointCloud",
          "label": "Cloud",
          "to": [
            {
              "node": "s_voxel",
              "port": "cloud"
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "cloud",
          "type": "PointCloud",
          "label": "Cloud",
          "from": {
            "node": "s_sor",
            "port": "cloud"
          }
        }
      ],
      "params": [
        {
          "name": "leafSize",
          "type": "vec3f",
          "label": "Leaf size",
          "default": [
            0.005,
            0.005,
            0.005
          ],
          "min": 0.0001,
          "unit": "m",
          "binds": [
            {
              "node": "s_voxel",
              "param": "leafSize"
            }
          ]
        }
      ]
    }
  },
  "params": {
    "planeTol": {
      "type": "float",
