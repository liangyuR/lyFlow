{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liangyuR/lyFlow/schema/operator-manifest.schema.json",
  "title": "OperatorManifestBundle",
  "description": "C++ 算子注册表导出的全量描述。前端据此生成节点面板、参数表单与类型校验，不硬编码任何算子。",
  "type": "object",
  "required": ["schemaVersion", "types", "operators"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedBy": { "type": "string", "description": "生成方标识，如 lyflow-core/0.1.0" },
    "types": {
      "type": "array",
      "description": "端口类型表。V1 规则：精确匹配 + Any 通配 + castableTo 显式转换。不做泛型。",
      "items": { "$ref": "#/$defs/portType" }
    },
    "bundles": {
      "type": "array",
      "description": "Bundle 声明（m8-plan L1/L2）：一根线带一组有名字的字段。端口类型写作 Bundle<kind>，类型检查只认 kind 相等；执行器在算子写出这种端口时按 fields 查字段齐不齐、类型对不对，不符报 contract_violation。没有包声明时整段不出现。",
      "items": { "$ref": "#/$defs/bundle" }
    },
    "operators": { "type": "array", "items": { "$ref": "#/$defs/operator" } },
    "importers": {
      "type": "array",
      "description": "注册了的「文本 → 图」导入器（ADR-0017）。前端据此列出「导入…」，不硬编码格式名。没有任何导入器时这一项不出现。",
      "items": { "$ref": "#/$defs/importer" }
    }
  },
  "$defs": {
    "bundle": {
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "pattern": "^[^<> ]+$", "description": "全局唯一，用 . 分命名空间，例如 gap.ScanPair。" },
        "label": { "type": "string" },
        "doc": { "type": "string" },
        "pack": { "type": "string", "description": "声明它的算子包，与 operator.pack 同一口径。" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "description": "有序字段表。结果仓、C ABI、事件、summary 与图输出按 <port>.<field> 寻址。",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[^.]+$", "description": "不能含 '.'：<port>.<field> 靠它分隔。" },
              "type": { "type": "string", "description": "types 表里的具体类型；不能是 Any、Error，也不能是另一个 Bundle（L1 不嵌套）。" },
              "doc": { "type": "string" }
            }
          }
        }
      }
    },
    "portType": {
      "type": "object",
      "required": ["name", "color"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "color": { "type": "string", "description": "端口与连线着色。零成本的可读性提升，M0 就做。" },
        "castableTo": { "type": "array", "items": { "type": "string" }, "description": "可隐式转换到的类型。" },
        "doc": { "type": "string" }
      }
    },
    "operator": {
      "type": "object",
      "required": ["id", "version", "label", "category", "inputs", "outputs", "params"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "全局唯一，用 . 分命名空间，如 filter.voxel_grid" },
        "version": { "$ref": "#/$defs/semver" },
        "pack": { "type": "string", "description": "算子来自哪个算子包，「名字」或「名字@版本」。core 自带的算子没有这一项。前端不解释它（ADR-0014）。" },
        "aliases": { "type": "array", "items": { "type": "string" }, "description": "旧 id，用于重命名后自动重定向。" },
        "label": { "type": "string" },
        "category": { "type": "string", "description": "用 / 分层，决定搜索面板的树形结构。" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "doc": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "port": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "description": "必须出现在 types 表中，或写成 Bundle<kind>（kind 在 bundles 里声明；裸的 Bundle 不能当端口类型）。" },
        "label": { "type": "string" },
        "doc": { "type": "string" },
        "required": { "type": "boolean", "default": true, "description": "仅对 inputs 有意义。" },
        "acceptsError": {
          "type": "boolean", "default": false,
          "description": "仅对 inputs 有意义（ADR-0016）。上游失败时本节点不被连坐成 cancelled，而是在这个端口上收到一个 Error 值。"
        },
        "lazy": {
          "type": "boolean", "default": false,
          "description": "仅对 inputs 有意义（ADR-0016）。这个端口的上游闭包不进初始计划，算子 compute 返回 Demand 时才被调度。"
        },
        "contract": { "$ref": "#/$defs/portContract" },
        "example": {
          "description": "一份样例值（m6-plan H8），任意 JSON。Record 端口尤其需要：只有 type 字串的话，「data.inlierCount 到底存不存在」得翻算子实现才知道。不是 JSON Schema，也不参与任何校验 —— 它只回答「这里长什么样」。"
        }
      }
    },
    "portContract": {
      "type": "object",
      "description": "端口契约（ADR-0024）。**只有四种键**，刻意不做表达式语言 —— 与 condition 同一条原则：需要更复杂的判断通常说明这个算子该拆了。执行器在**输入绑定时**检查（bypass 透传与 Error 值不检查），违反报 contract_violation 并进 run summary 的 contractViolations。没声明契约的端口一行检查都不跑。",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "elementCount": {
          "type": "object",
          "description": "元素数：点云 = 点数，Indices = 下标个数，Tensor = 元素总数，其余 = 1。eq 与 min/max 只能选一种写法。",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "eq": { "type": "integer", "minimum": 0 },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "finite": {
          "const": true,
          "description": "PointCloud 的坐标 / Tensor 的元素 / Measurement 的值必须全是有限的。只能写 true —— `false` 读起来像「这里允许 NaN」，而那是**没有契约**。O(n) 一遍，只在声明了它的端口上跑。"
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": -1 },
          "description": "张量形状，-1 表示这一维随便。只对 Tensor 端口有意义。"
        },
        "recordType": {
          "type": "string",
          "minLength": 1,
          "description": "Record 的 type 字串。只对 Record 端口有意义。"
        }
      }
    },
    "importer": {
      "type": "object",
      "required": ["kind", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "description": "传给 lyflow_import 的第一个参数。" },
        "label": { "type": "string" },
        "doc": { "type": "string" },
        "pack": { "type": "string", "description": "来自哪个算子包。core 自带的没有这一项。" }
      }
    },
    "param": {
      "type": "object",
      "required": ["name", "type", "default"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": {
          "enum": ["bool", "int", "float", "vec2f", "vec3f", "vec4f", "enum", "flags",
                   "string", "text", "path", "color", "transform", "curve"],
          "description": "决定前端渲染哪个控件。新增类型 = 前端加一个 case。"
        },
        "label": { "type": "string" },
        "doc": { "type": "string" },
        "default": { "description": "任意 JSON 值，需与 type 匹配。GraphDoc 稀疏存储时以此为基准。" },
        "group": { "type": "string", "description": "参数分组标题。" },
        "advanced": { "type": "boolean", "default": false, "description": "默认收进折叠区。" },
        "min": { "type": "number" },
        "max": { "type": "number", "description": "硬边界，超出即非法。" },
        "softMin": { "type": "number" },
        "softMax": { "type": "number", "description": "滑块范围，可手输超出。" },
        "step": { "type": "number" },
        "unit": { "type": "string" },
        "componentLabels": { "type": "array", "items": { "type": "string" }, "description": "vecNf 的分量名，默认 X/Y/Z/W。" },
        "options": {
          "type": "array",
          "description": "enum / flags 的选项。",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": ["string", "integer"] },
              "label": { "type": "string" },
              "doc": { "type": "string" }
            }
          }
        },
        "placeholder": { "type": "string" },
        "pattern": { "type": "string", "description": "string 的校验正则。" },
        "rows": { "type": "integer", "description": "text 的行数。" },
        "filters": {
          "type": "array",
          "description": "path 的文件类型过滤。",
          "items": {
            "type": "object",
            "required": ["name", "extensions"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "extensions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "mode": { "enum": ["open", "save", "dir"], "description": "path 的选择模式。" },
        "alpha": { "type": "boolean", "description": "color 是否带 alpha 通道。" },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "enabledWhen": { "$ref": "#/$defs/condition" }
      }
    },
    "condition": {
      "type": "object",
      "description": "有意做得很弱：只支持对同节点其他参数的等值/包含判断，不是通用表达式引擎。需要复杂逻辑说明算子该拆了。",
      "required": ["param"],
      "additionalProperties": false,
      "properties": {
        "param": { "type": "string" },
        "eq": {},
        "ne": {},
        "in": { "type": "array" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancellable": { "type": "boolean", "default": false, "description": "支持中途取消 → 可用于 live preview。协作式：算子要在自己的循环里轮询。PCL 之类第三方算法一旦进去就出不来，这类算子必须如实填 false，否则前端会承诺一个做不到的 Esc。" },
        "previewable": { "type": "boolean", "default": false, "description": "支持降级质量的快速预览。" },
        "deterministic": { "type": "boolean", "default": true, "description": "同输入同输出 → 可参与缓存。" }
      }
    },
    "semver": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" }
  }
}
