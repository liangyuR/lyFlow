    { "id": "n_cut", "op": "filter.passthrough", "opVersion": "1.0.0", "params": {}, "ui": { "position": { "x": 520, "y": 0 } } },
    { "id": "n_show", "op": "test.param_showcase", "opVersion": "1.0.0", "params": {}, "ui": { "position": { "x": 260, "y": 200 } } }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "n_gen", "port": "cloud" }, "to": { "node": "n_voxel", "port": "cloud" } },
    { "id": "e2", "from": { "node": "n_voxel", "port": "cloud" }, "to": { "node": "n_cut", "port": "cloud" } },
    { "id": "e3", "from": { "node": "n_gen", "port": "cloud" }, "to": { "node": "n_show", "port": "cloud" } }
  ],
  "groups": [],
  "subgraphs": {},
  "params": {
    "pointCount": {
