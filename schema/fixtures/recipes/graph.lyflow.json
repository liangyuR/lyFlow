{
  "schemaVersion": 1,
  "id": "01JRECIPEFIXTURE0000000000",
  "name": "配方失配夹具",
  "meta": {
    "app": "lyflow/0.1.0",
    "note": "param-recipe P3 的共享夹具：graph.recipes/ 里每个配方文件触发一类失配，期望的报告在 expected.json。编辑器单测（packages/editor/test/recipes.test.mjs）与 P4 的 CLI（Rust）都对着它验。n_show 是 test.param_showcase，只在 LYFLOW_TEST_OPS=1 时注册；夹具只用来判失配，不需要能跑。"
  },
  "nodes": [
    { "id": "n_gen", "op": "gen.synthetic", "opVersion": "1.0.0", "params": {}, "ui": { "position": { "x": 0, "y": 0 } } },
