macro(lyflow_setup_pcl_support)
  set(_components common io filters kdtree search segmentation sample_consensus features)
  find_package(PCL 1.15.1 REQUIRED COMPONENTS ${_components})
  find_package(Boost REQUIRED COMPONENTS filesystem)
  file(GLOB _sources CONFIGURE_DEPENDS "${LYFLOW_PACK_ROOT}/std-pointcloud/src/*.cpp")
  add_library(lyflow_pcl_support STATIC ${_sources})
  lyflow_apply_common(lyflow_pcl_support)
  set_target_properties(lyflow_pcl_support PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_include_directories(lyflow_pcl_support PUBLIC "${LYFLOW_PACK_ROOT}/std-pointcloud/include")
  set(_libraries "")
  foreach(_component IN LISTS _components)
    if(TARGET PCL::${_component})
      list(APPEND _libraries PCL::${_component})
    elseif(TARGET pcl_${_component})
      list(APPEND _libraries pcl_${_component})
    endif()
  endforeach()
  if(_libraries)
    target_link_libraries(lyflow_pcl_support PUBLIC ${_libraries})
  else()
    target_link_libraries(lyflow_pcl_support PUBLIC ${PCL_LIBRARIES})
    target_include_directories(lyflow_pcl_support SYSTEM PUBLIC ${PCL_INCLUDE_DIRS})
    target_compile_options(lyflow_pcl_support PUBLIC ${PCL_DEFINITIONS})
  endif()
  target_link_libraries(lyflow_pcl_support PUBLIC Boost::filesystem lyflow_data_contract)
  if(MSVC)
    target_compile_options(lyflow_pcl_support PUBLIC /wd4127 /wd4267 /wd4244 /wd4324)
  endif()
endmacro()

function(lyflow_setup_pointcloud_algorithms)
  file(GLOB _sources CONFIGURE_DEPENDS "${LYFLOW_PACK_ROOT}/std-pointcloud/algo/*.cpp")
  list(REMOVE_ITEM _sources "${LYFLOW_PACK_ROOT}/std-pointcloud/algo/p2_matching.cpp")
  add_library(lyflow_std_algo STATIC ${_sources})
  lyflow_apply_common(lyflow_std_algo)
  set_target_properties(lyflow_std_algo PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_include_directories(lyflow_std_algo PUBLIC "${LYFLOW_PACK_ROOT}/std-pointcloud")
  target_link_libraries(lyflow_std_algo PUBLIC lyflow_pcl_support lyflow_profile_robust_kernel)
  if(MSVC)
    target_compile_options(lyflow_std_algo PRIVATE /wd4996)
  endif()
endfunction()

function(lyflow_setup_matching_pointcloud)
