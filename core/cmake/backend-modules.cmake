function(lyflow_setup_yaml_support)
  find_package(yaml-cpp CONFIG REQUIRED)
  add_library(lyflow_yaml_support INTERFACE)
  if(TARGET yaml-cpp::yaml-cpp)
    target_link_libraries(lyflow_yaml_support INTERFACE yaml-cpp::yaml-cpp)
  else()
    target_link_libraries(lyflow_yaml_support INTERFACE yaml-cpp)
  endif()
endfunction()

function(lyflow_setup_onnx_support)
  set(_version "1.32.0")
  if(NOT DEFINED LYFLOW_ONNXRUNTIME_ROOT OR "${LYFLOW_ONNXRUNTIME_ROOT}" STREQUAL "")
    if(DEFINED ENV{LYFLOW_ONNXRUNTIME_ROOT} AND NOT "$ENV{LYFLOW_ONNXRUNTIME_ROOT}" STREQUAL "")
      set(LYFLOW_ONNXRUNTIME_ROOT "$ENV{LYFLOW_ONNXRUNTIME_ROOT}")
    else()
      get_filename_component(_repository "${LYFLOW_PACK_ROOT}/.." ABSOLUTE)
      set(LYFLOW_ONNXRUNTIME_ROOT "${_repository}/third_party/onnxruntime/onnxruntime-win-x64-${_version}")
    endif()
  endif()
  file(TO_CMAKE_PATH "${LYFLOW_ONNXRUNTIME_ROOT}" _root)
  foreach(_file include/onnxruntime_cxx_api.h lib/onnxruntime.lib lib/onnxruntime.dll lib/onnxruntime_providers_shared.dll)
    if(NOT EXISTS "${_root}/${_file}")
      message(FATAL_ERROR "onnx-support requires ONNX Runtime ${_version}: missing ${_root}/${_file}. Run scripts/fetch-onnxruntime.ps1 or set LYFLOW_ONNXRUNTIME_ROOT.")
    endif()
  endforeach()
  add_library(lyflow_onnx_support INTERFACE)
  target_include_directories(lyflow_onnx_support INTERFACE "${_root}/include")
  target_link_libraries(lyflow_onnx_support INTERFACE "${_root}/lib/onnxruntime.lib")
  file(COPY "${_root}/lib/onnxruntime.dll" "${_root}/lib/onnxruntime_providers_shared.dll"
    DESTINATION "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
endfunction()

function(lyflow_setup_opencv_support)
  find_package(OpenCV CONFIG QUIET COMPONENTS core imgproc imgcodecs objdetect)
  if(NOT OpenCV_FOUND OR OpenCV_VERSION VERSION_LESS "4.6.0")
    message(FATAL_ERROR "opencv-support requires OpenCV >=4.6. Run scripts/build-vision-deps.ps1 and set OpenCV_DIR.")
  endif()
  if(OpenCV_VERSION VERSION_LESS "5.0.0")
    find_package(OpenCV 4.6 CONFIG REQUIRED COMPONENTS core imgproc imgcodecs calib3d objdetect)
    set(_geometry opencv_calib3d)
  else()
    find_package(OpenCV 5.1 CONFIG REQUIRED COMPONENTS core imgproc imgcodecs geometry objdetect)
    set(_geometry opencv_geometry)
  endif()
  set(_markers opencv_objdetect)
  if(OpenCV_VERSION VERSION_LESS "4.7.0")
    find_package(OpenCV 4.6 CONFIG REQUIRED COMPONENTS core imgproc imgcodecs calib3d objdetect aruco)
    list(APPEND _markers opencv_aruco)
  endif()
  set(_targets ${OpenCV_LIBS} opencv_flann opencv_features opencv_features2d)
  foreach(_target IN LISTS _targets)
    if(TARGET ${_target})
      get_target_property(_configurations ${_target} IMPORTED_CONFIGURATIONS)
      if("RELWITHDEBINFO" IN_LIST _configurations AND NOT "RELEASE" IN_LIST _configurations)
        set_target_properties(${_target} PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO RelWithDebInfo
          MAP_IMPORTED_CONFIG_RELEASE RelWithDebInfo MAP_IMPORTED_CONFIG_MINSIZEREL RelWithDebInfo)
      endif()
      if(WIN32)
        get_target_property(_kind ${_target} TYPE)
        if(_kind STREQUAL "SHARED_LIBRARY")
          unset(_dll)
          foreach(_configuration RELWITHDEBINFO RELEASE)
            if(_configuration IN_LIST _configurations)
              get_target_property(_candidate ${_target} IMPORTED_LOCATION_${_configuration})
              if(EXISTS "${_candidate}")
                set(_dll "${_candidate}")
                break()
              endif()
            endif()
          endforeach()
          if(NOT _dll)
            message(FATAL_ERROR "${_target} requires a Release or RelWithDebInfo DLL for the dynamic CRT build.")
          endif()
          file(COPY "${_dll}" DESTINATION "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
        endif()
      endif()
    endif()
  endforeach()
  file(GLOB _sources CONFIGURE_DEPENDS "${LYFLOW_PACK_ROOT}/std-image/src/*.cpp")
  add_library(lyflow_opencv_support STATIC ${_sources})
  lyflow_apply_common(lyflow_opencv_support)
  set_target_properties(lyflow_opencv_support PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_include_directories(lyflow_opencv_support PUBLIC "${LYFLOW_PACK_ROOT}/std-image/include")
  target_link_libraries(lyflow_opencv_support PUBLIC lyflow_data_contract opencv_core opencv_imgproc opencv_imgcodecs ${_geometry} ${_markers})
endfunction()

