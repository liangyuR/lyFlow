include_guard(GLOBAL)

function(lyflow_declare_module)
  cmake_parse_arguments(M "" "NAME;TARGET;SETUP" "REQUIRES" ${ARGN})
  if(M_UNPARSED_ARGUMENTS OR NOT M_NAME MATCHES "^[a-z][a-z0-9_-]*$" OR NOT M_TARGET OR NOT M_SETUP)
    message(FATAL_ERROR "Invalid lyFlow module declaration: ${ARGN}")
  endif()
  get_property(_names GLOBAL PROPERTY LYFLOW_MODULE_NAMES)
  if(M_NAME IN_LIST _names)
    message(FATAL_ERROR "Duplicate lyFlow module: ${M_NAME}")
  endif()
  set_property(GLOBAL APPEND PROPERTY LYFLOW_MODULE_NAMES "${M_NAME}")
  foreach(_field TARGET SETUP REQUIRES)
    set_property(GLOBAL PROPERTY "LYFLOW_MODULE_${M_NAME}_${_field}" "${M_${_field}}")
  endforeach()
endfunction()

function(_lyflow_visit_module name chain)
  get_property(_names GLOBAL PROPERTY LYFLOW_MODULE_NAMES)
  if(NOT name IN_LIST _names)
    message(FATAL_ERROR "Missing lyFlow module: ${name}; required by ${chain}")
  endif()
  if(name IN_LIST chain)
    message(FATAL_ERROR "lyFlow module dependency cycle: ${chain};${name}")
  endif()
  get_property(_sorted GLOBAL PROPERTY LYFLOW_MODULE_SORTED)
  if(name IN_LIST _sorted)
    return()
  endif()
  list(APPEND chain "${name}")
  get_property(_requires GLOBAL PROPERTY "LYFLOW_MODULE_${name}_REQUIRES")
  foreach(_dependency IN LISTS _requires)
    _lyflow_visit_module("${_dependency}" "${chain}")
  endforeach()
  set_property(GLOBAL APPEND PROPERTY LYFLOW_MODULE_SORTED "${name}")
endfunction()

function(lyflow_resolve_modules output)
  set_property(GLOBAL PROPERTY LYFLOW_MODULE_SORTED "")
  foreach(_module IN LISTS ARGN)
    _lyflow_visit_module("${_module}" "")
  endforeach()
  get_property(_sorted GLOBAL PROPERTY LYFLOW_MODULE_SORTED)
  set("${output}" "${_sorted}" PARENT_SCOPE)
endfunction()

function(lyflow_configure_modules)
  lyflow_resolve_modules(_ordered ${ARGN})
  foreach(_module IN LISTS _ordered)
    get_property(_target GLOBAL PROPERTY "LYFLOW_MODULE_${_module}_TARGET")
    if(TARGET "${_target}")
      get_target_property(_owner "${_target}" LYFLOW_MODULE_ID)
      if(NOT _owner STREQUAL _module)
        message(FATAL_ERROR "Module target ${_target} has an undeclared provider")
      endif()
    else()
      get_property(_setup GLOBAL PROPERTY "LYFLOW_MODULE_${_module}_SETUP")
      if(NOT COMMAND "${_setup}")
        message(FATAL_ERROR "Missing setup function for module ${_module}: ${_setup}")
      endif()
      cmake_language(CALL "${_setup}")
      if(NOT TARGET "${_target}")
        message(FATAL_ERROR "Module ${_module} did not provide target ${_target}")
      endif()
      set_property(TARGET "${_target}" PROPERTY LYFLOW_MODULE_ID "${_module}")
      set_property(GLOBAL APPEND PROPERTY LYFLOW_ENABLED_MODULES "${_module}")
    endif()
  endforeach()
endfunction()

function(lyflow_pack_dependencies)
  cmake_parse_arguments(P "" "NAME;DEFAULT" "MODULES;PACKS" ${ARGN})
  if(P_UNPARSED_ARGUMENTS OR NOT P_NAME MATCHES "^[a-z][a-z0-9_-]*$" OR NOT DEFINED P_DEFAULT)
    message(FATAL_ERROR "Invalid lyFlow pack dependency declaration: ${ARGN}")
  endif()
  get_property(_packs GLOBAL PROPERTY LYFLOW_DECLARED_PACKS)
  if(P_NAME IN_LIST _packs)
    message(FATAL_ERROR "Duplicate lyFlow pack dependency declaration: ${P_NAME}")
  endif()
  set_property(GLOBAL APPEND PROPERTY LYFLOW_DECLARED_PACKS "${P_NAME}")
  foreach(_field DEFAULT MODULES PACKS)
    set_property(GLOBAL PROPERTY "LYFLOW_PACK_${P_NAME}_${_field}" "${P_${_field}}")
  endforeach()
endfunction()

function(_lyflow_visit_pack name chain)
  get_property(_declared GLOBAL PROPERTY LYFLOW_DECLARED_PACKS)
  if(NOT name IN_LIST _declared)
    message(FATAL_ERROR "Missing lyFlow pack declaration: ${name}")
  endif()
  get_property(_enabled GLOBAL PROPERTY LYFLOW_SELECTED_PACKS)
  if(NOT name IN_LIST _enabled)
    message(FATAL_ERROR "Missing enabled pack ${name}; required by ${chain}. Add it to LYFLOW_PACKS.")
  endif()
  if(name IN_LIST chain)
    message(FATAL_ERROR "lyFlow pack dependency cycle: ${chain};${name}")
  endif()
  get_property(_sorted GLOBAL PROPERTY LYFLOW_PACK_SORTED)
  if(name IN_LIST _sorted)
    return()
  endif()
  list(APPEND chain "${name}")
  get_property(_requires GLOBAL PROPERTY "LYFLOW_PACK_${name}_PACKS")
  foreach(_dependency IN LISTS _requires)
    _lyflow_visit_pack("${_dependency}" "${chain}")
  endforeach()
  set_property(GLOBAL APPEND PROPERTY LYFLOW_PACK_SORTED "${name}")
endfunction()

function(lyflow_resolve_packs output)
  set_property(GLOBAL PROPERTY LYFLOW_SELECTED_PACKS "${ARGN}")
  set_property(GLOBAL PROPERTY LYFLOW_PACK_SORTED "")
  foreach(_pack IN LISTS ARGN)
    _lyflow_visit_pack("${_pack}" "")
  endforeach()
  get_property(_sorted GLOBAL PROPERTY LYFLOW_PACK_SORTED)
  set("${output}" "${_sorted}" PARENT_SCOPE)
endfunction()
