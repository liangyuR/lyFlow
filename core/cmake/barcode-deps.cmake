include_guard(GLOBAL)

function(lyflow_configure_barcode_cpu)
  if(TARGET lyflow_barcode_backend)
    return()
  endif()
  get_filename_component(_repository "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
  set(LYFLOW_BARCODE_DEPS_DIR "${_repository}/build/barcode-deps" CACHE PATH "Prepared pinned ZXing-C++ sources")
  find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
  execute_process(
    COMMAND "${Python3_EXECUTABLE}" "${_repository}/scripts/fetch-barcode-deps.py"
            --output-dir "${LYFLOW_BARCODE_DEPS_DIR}" --verify-only --offline
    RESULT_VARIABLE _verified OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
  if(NOT _verified EQUAL 0)
    message(FATAL_ERROR "Pinned barcode source verification failed: ${_output}${_error}")
  endif()
  set(BUILD_SHARED_LIBS OFF)
  set(CMAKE_CXX_STANDARD 20)
  set(CMAKE_CXX_STANDARD_REQUIRED ON)
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
  set(ZXING_READERS ON)
  set(ZXING_WRITERS OFF)
  set(ZXING_C_API OFF)
  set(ZXING_EXPERIMENTAL_API OFF)
  set(ZXING_UNIT_TESTS OFF)
  set(ZXING_BLACKBOX_TESTS OFF)
  set(ZXING_EXAMPLES OFF)
  set(ZXING_DEPENDENCIES LOCAL)
  set(ZXING_LINK_CPP_STATICALLY OFF)
  set(ZXING_USE_BUNDLED_ZINT OFF)
  foreach(_format 1D AZTEC DATAMATRIX MAXICODE PDF417 QRCODE)
    set(ZXING_ENABLE_${_format} ON)
  endforeach()
  add_subdirectory("${LYFLOW_BARCODE_DEPS_DIR}/zxing/core" "${CMAKE_BINARY_DIR}/barcode/zxing" EXCLUDE_FROM_ALL)
  set_target_properties(ZXing PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_STANDARD 20)
  add_library(lyflow_barcode_backend STATIC "${_repository}/packs/std-image/barcode/backend.cpp")
  target_include_directories(lyflow_barcode_backend PUBLIC "${_repository}/packs/std-image/barcode")
  target_link_libraries(lyflow_barcode_backend PRIVATE ZXing::ZXing)
  set_target_properties(lyflow_barcode_backend PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON POSITION_INDEPENDENT_CODE ON)
  if(MSVC)
    target_compile_options(lyflow_barcode_backend PRIVATE /utf-8)
  endif()
endfunction()

function(lyflow_add_barcode_contract_tests _test_target)
  if(NOT TARGET lyflow_barcode_backend OR NOT TARGET ${_test_target})
    message(FATAL_ERROR "Barcode contract tests require the backend and a test executable")
  endif()
  get_filename_component(_repository "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
  if(NOT TARGET lyflow_barcode_contract_tests)
    add_library(lyflow_barcode_contract_tests OBJECT "${_repository}/packs/std-image/barcode/contract_tests.cpp")
    target_include_directories(lyflow_barcode_contract_tests PRIVATE "${_repository}/core/third_party" ${OpenCV_INCLUDE_DIRS})
    target_compile_definitions(lyflow_barcode_contract_tests PRIVATE ZXING_INTERNAL)
    target_link_libraries(lyflow_barcode_contract_tests PRIVATE ZXing::ZXing opencv_objdetect)
    set_target_properties(lyflow_barcode_contract_tests PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
    if(MSVC)
      target_compile_options(lyflow_barcode_contract_tests PRIVATE /utf-8)
    endif()
  endif()
  target_sources(${_test_target} PRIVATE $<TARGET_OBJECTS:lyflow_barcode_contract_tests>)
endfunction()
