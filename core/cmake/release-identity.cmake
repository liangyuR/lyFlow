include_guard(GLOBAL)

function(lyflow_release_combination_matches output configuration packs modules)
  file(READ "${configuration}" _release_json)
  foreach(_field packs modules)
    string(JSON _type TYPE "${_release_json}" "${_field}")
    if(NOT _type STREQUAL "ARRAY")
      message(FATAL_ERROR "Release ${_field} must be an array")
    endif()
    string(JSON _length LENGTH "${_release_json}" "${_field}")
    set(_expected_${_field} "")
    if(_length GREATER 0)
      math(EXPR _last "${_length} - 1")
      foreach(_index RANGE 0 ${_last})
        string(JSON _name GET "${_release_json}" "${_field}" ${_index})
        if(NOT _name MATCHES "^[a-z][a-z0-9-]*$" OR _name IN_LIST _expected_${_field})
          message(FATAL_ERROR "Release ${_field} contains an invalid or duplicate identity")
        endif()
        list(APPEND _expected_${_field} "${_name}")
      endforeach()
    endif()
    list(SORT _expected_${_field})
    set(_actual_${_field} "${${_field}}")
    list(REMOVE_DUPLICATES _actual_${_field})
    list(SORT _actual_${_field})
  endforeach()
  if(_actual_packs STREQUAL _expected_packs AND _actual_modules STREQUAL _expected_modules)
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()
