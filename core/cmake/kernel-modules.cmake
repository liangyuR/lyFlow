include_guard(GLOBAL)
get_filename_component(LYFLOW_KERNEL_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../kernels" ABSOLUTE)
set(LYFLOW_KERNEL_ROOT "${LYFLOW_KERNEL_ROOT}" CACHE INTERNAL "Public portable kernel sources")

function(lyflow_setup_data_contract)
  add_library(lyflow_data_contract INTERFACE)
  add_library(lyflow::data_contract ALIAS lyflow_data_contract)
  set_target_properties(lyflow_data_contract PROPERTIES EXPORT_NAME data_contract)
  target_include_directories(lyflow_data_contract INTERFACE
    "$<BUILD_INTERFACE:${LYFLOW_INCLUDE}>" "$<BUILD_INTERFACE:${LYFLOW_TP}>"
    "$<INSTALL_INTERFACE:include>")
  target_compile_features(lyflow_data_contract INTERFACE cxx_std_17)
  install(TARGETS lyflow_data_contract EXPORT lyflow-kernel-targets)
endfunction()

function(lyflow_kernel_target target public_name)
  add_library(${target} STATIC ${ARGN})
  add_library(lyflow::${public_name} ALIAS ${target})
  set_target_properties(${target} PROPERTIES EXPORT_NAME ${public_name} POSITION_INDEPENDENT_CODE ON)
  target_link_libraries(${target} PUBLIC lyflow_data_contract)
  target_include_directories(${target} PUBLIC
    "$<BUILD_INTERFACE:${LYFLOW_KERNEL_ROOT}/include>" "$<INSTALL_INTERFACE:include>")
  if(MSVC)
    target_compile_options(${target} PRIVATE /EHsc /W4 /permissive- /utf-8 /bigobj)
    target_compile_definitions(${target} PRIVATE NOMINMAX _CRT_SECURE_NO_WARNINGS)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  endif()
  install(TARGETS ${target} EXPORT lyflow-kernel-targets ARCHIVE DESTINATION lib)
endfunction()

function(lyflow_setup_geometry_kernel)
  lyflow_kernel_target(lyflow_geometry_kernel geometry_kernel
    "${LYFLOW_KERNEL_ROOT}/src/geometry.cpp" "${LYFLOW_KERNEL_ROOT}/src/rigid.cpp"
    "${LYFLOW_KERNEL_ROOT}/src/constraints.cpp")
endfunction()

function(lyflow_setup_metrology_kernel)
  lyflow_kernel_target(lyflow_metrology_kernel metrology_kernel "${LYFLOW_KERNEL_ROOT}/src/metrology.cpp")
endfunction()

function(lyflow_setup_eigen_headers)
  get_filename_component(_prepared "${LYFLOW_KERNEL_ROOT}/../build/profile-math-deps/install/share/eigen3/cmake" ABSOLUTE)
  find_package(Eigen3 5.0.1 EXACT CONFIG QUIET HINTS "${_prepared}")
  if(NOT Eigen3_FOUND)
    message(FATAL_ERROR "Profile analysis requires Eigen 5.0.1 headers only. Run python scripts/fetch-profile-math-deps.py --output-dir build/profile-math-deps, or set Eigen3_DIR to an exact 5.0.1 installation. No PCL/OpenCV/ORT is required.")
  endif()
  add_library(lyflow_eigen_headers INTERFACE)
  get_target_property(_includes Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)
  target_include_directories(lyflow_eigen_headers SYSTEM INTERFACE ${_includes})
  set(_notices "")
  set(_notice_count 0)
  foreach(_name COPYING.README COPYING.APACHE COPYING.BSD COPYING.MINPACK COPYING.MPL2)
    unset(_notice)
    unset(_notice CACHE)
    find_file(_notice NAMES "${_name}" PATHS "${Eigen3_DIR}" "${Eigen3_DIR}/.." NO_DEFAULT_PATH)
    if(_notice)
      math(EXPR _notice_count "${_notice_count} + 1")
      file(READ "${_notice}" _text)
      string(APPEND _notices "${_name}:\n${_text}\n\n")
    endif()
  endforeach()
  if(NOT _notice_count EQUAL 5)
    unset(_notice)
    unset(_notice CACHE)
    find_file(_notice NAMES copyright PATHS "${Eigen3_DIR}" "${Eigen3_DIR}/.." NO_DEFAULT_PATH)
    if(NOT _notice)
      message(FATAL_ERROR "Eigen installation is missing distributable license notices")
    endif()
    file(READ "${_notice}" _notices)
  endif()
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/profile-eigen-NOTICE" "${_notices}")
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/profile-eigen-NOTICE" DESTINATION licenses/profile/eigen RENAME NOTICE)
  install(FILES "${LYFLOW_KERNEL_ROOT}/../packaging/profile-math-deps.json" DESTINATION licenses/profile/eigen RENAME source.json)
endfunction()

function(lyflow_setup_profile_kernel)
  lyflow_kernel_target(lyflow_profile_kernel profile_kernel "${LYFLOW_KERNEL_ROOT}/src/profile.cpp")
endfunction()

function(lyflow_setup_profile_contract)
  add_library(lyflow_profile_contract INTERFACE)
  target_include_directories(lyflow_profile_contract INTERFACE "${LYFLOW_PACK_ROOT}/std-profile/include")
  target_link_libraries(lyflow_profile_contract INTERFACE lyflow_data_contract)
endfunction()

function(lyflow_setup_profile_analysis_kernel)
  lyflow_kernel_target(lyflow_profile_analysis_kernel profile_analysis_kernel
    "${LYFLOW_KERNEL_ROOT}/src/profile_analysis.cpp")
  get_target_property(_includes lyflow_eigen_headers INTERFACE_INCLUDE_DIRECTORIES)
  target_include_directories(lyflow_profile_analysis_kernel SYSTEM PRIVATE ${_includes})
endfunction()

