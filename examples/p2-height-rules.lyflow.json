{
  "schemaVersion": 1,
  "id": "01P2P2HEIGHTRULES",
  "name": "P2-height-rules",
  "nodes": [
    {
      "id": "source",
      "op": "io.load_cloud",
      "params": {
        "frame": "input"
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": "objectText",
      "op": "value.string",
      "params": {
        "value": "{\"type\":\"vision.Poses3D.v1\",\"data\":{\"frame\":\"input\",\"unit\":\"m\",\"items\":[{\"id\":\"part\",\"frame\":\"input\",\"unit\":\"m\",\"position\":[0,0,0.5],\"rotation\":[0,0,0,1],\"size\":[0.1,0.1,1],\"pickable\":false}]}}"
      },
      "ui": {
        "position": {
          "x": 320,
          "y": 0
        }
      }
    },
    {
      "id": "objects",
      "op": "pose.from_text",
      "params": {},
      "ui": {
        "position": {
          "x": 640,
          "y": 0
        }
      }
    },
    {
      "id": "workspaceText",
      "op": "value.string",
      "params": {
        "value": "{\"type\":\"vision.Pose3D.v1\",\"data\":{\"id\":\"workspace\",\"frame\":\"input\",\"unit\":\"m\",\"position\":[0,0,0.5],\"rotation\":[0,0,0,1],\"size\":[0.5,0.5,1.2]}}"
      },
      "ui": {
        "position": {
          "x": 960,
          "y": 0
        }
      }
    },
    {
      "id": "workspace",
      "op": "pose.from_text",
      "params": {},
      "ui": {
        "position": {
          "x": 0,
          "y": 230
        }
      }
    },
    {
      "id": "observed",
      "op": "value.boolean",
      "params": {},
      "ui": {
        "position": {
          "x": 320,
          "y": 230
        }
      }
    },
    {
      "id": "top",
      "op": "cloud.top_layer",
      "params": {
        "frame": "input",
        "minPoints": 8,
        "extractRadius": 0.02
      },
      "ui": {
        "position": {
          "x": 640,
          "y": 230
        }
      }
    },
    {
      "id": "relative",
      "op": "cloud.neighbor_height",
      "params": {
        "frame": "input",
        "minPoints": 8,
        "method": "point_plane"
      },
      "ui": {
        "position": {
          "x": 960,
          "y": 230
        }
      }
    },
    {
      "id": "patches",
      "op": "cloud.plane_patches",
      "params": {
        "frame": "input",
        "minPoints": 8,
        "maxPlanes": 4,
        "mode": "bounds",
        "cellSize": 0.02,
        "minCoverage": 0.2
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 460
        }
      }
    },
    {
      "id": "tote",
      "op": "cloud.empty_tote",
      "params": {
        "frame": "input"
      },
      "ui": {
        "position": {
          "x": 320,
          "y": 460
        }
      }
    }
  ],
  "edges": [
    {
      "id": "0",
      "from": {
        "node": "objectText",
        "port": "value"
      },
      "to": {
        "node": "objects",
        "port": "text"
      }
    },
    {
      "id": "1",
      "from": {
        "node": "workspaceText",
