        "port": "cloud"
      }
    },
    {
      "id": "3",
      "from": {
        "node": "source",
        "port": "cloud"
      },
      "to": {
        "node": "relative",
        "port": "cloud"
      }
    },
    {
      "id": "4",
      "from": {
        "node": "objects",
        "port": "poses"
      },
      "to": {
        "node": "relative",
        "port": "instances"
      }
    },
    {
      "id": "5",
      "from": {
        "node": "workspace",
        "port": "poses"
      },
      "to": {
        "node": "relative",
        "port": "workspace"
      }
    },
    {
      "id": "6",
      "from": {
        "node": "source",
        "port": "cloud"
      },
      "to": {
        "node": "patches",
        "port": "cloud"
      }
    },
    {
      "id": "7",
      "from": {
        "node": "source",
        "port": "cloud"
      },
      "to": {
        "node": "tote",
        "port": "cloud"
      }
    },
    {
      "id": "8",
      "from": {
        "node": "relative",
        "port": "instances"
      },
      "to": {
        "node": "tote",
        "port": "instances"
      }
    },
    {
      "id": "9",
      "from": {
        "node": "observed",
        "port": "value"
      },
      "to": {
        "node": "tote",
        "port": "observation"
      }
    }
  ],
  "outputs": {
    "height": {
      "node": "top",
      "port": "height"
    },
    "top": {
      "node": "top",
      "port": "top"
    },
    "rest": {
      "node": "top",
      "port": "rest"
    },
    "relativeHeight": {
      "node": "relative",
      "port": "heights"
    },
    "objects": {
      "node": "relative",
      "port": "instances"
    },
    "patches": {
      "node": "patches",
      "port": "instances"
    },
    "patchMetrics": {
      "node": "patches",
      "port": "patches"
    },
    "uncovered": {
      "node": "patches",
      "port": "uncovered"
    },
    "toteStatus": {
      "node": "tote",
      "port": "status"
    }
  },
  "params": {
    "cloudFile": {
      "type": "path",
      "default": "p2-height-rules.pcd",
      "binds": ["source.path"]
    },
    "layerThickness": {
      "type": "float",
      "unit": "m",
      "default": 0.02,
      "binds": ["top.layerThickness"]
    },
    "observationValid": {
      "type": "bool",
