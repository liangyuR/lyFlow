<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Tauri exe（lyflow-app）专有的那一块清单：Common-Controls v6 依赖。
  原本是 Tauri 默认清单的内容，dialog 插件需要；缺了它文件对话框会退回
  Windows 95 的样式 —— 而且不报错，只是看着不对。

  activeCodePage=UTF-8（D9）不在这里，在 core/lyflow-utf8.manifest：
  build.rs 让 link.exe 把那份贴进本包的所有 exe（CLI、测试），lyflow-app 再额外
  合并这一份。两份都由 link.exe 读文件合并，所以注释里写中文没关系。

  不走 tauri_build 的 app_manifest：那条路把清单内联进 .rc 交给 rc.exe，rc 按系统
  ANSI 代码页转码，ACP=936 的机器上中文注释被转成 GBK、声明却还是 UTF-8，
  exe 报 os error 14001（并行配置不正确）起不来。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
