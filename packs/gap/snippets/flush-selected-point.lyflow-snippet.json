{
  "schemaVersion": 1,
  "id": "gap.flush_selected_point",
  "label": "段差 · 选点",
  "category": "间隙",
  "doc": "基准面拟一条线，参考点取 target 框 min 角最近的云点（flush.ref_type = selected point），量段差并判定。",
  "nodes": [
    { "id": "line", "op": "gap.role_line", "params": { "role": "datum" },
      "ui": { "position": { "x": 0, "y": 0 }, "title": "基准线" } },
    { "id": "ref", "op": "gap.ref_point", "params": { "method": "selected_point", "role": "target" },
      "ui": { "position": { "x": 0, "y": 190 }, "title": "参考点（选点）" } },
    { "id": "flush", "op": "gap.flush",
      "ui": { "position": { "x": 260, "y": 90 }, "title": "段差" } },
    { "id": "judge", "op": "gap.judge",
      "ui": { "position": { "x": 500, "y": 90 }, "title": "判定段差" } }
  ],
  "edges": [
    { "from": { "node": "line", "port": "line" }, "to": { "node": "flush", "port": "baseLine" } },
    { "from": { "node": "ref", "port": "point" }, "to": { "node": "flush", "port": "refPoint" } },
    { "from": { "node": "flush", "port": "value" }, "to": { "node": "judge", "port": "value" } }
  ],
  "ports": {
    "inputs": [
      { "node": "line", "port": "scan", "hint": "定位之后的剖面对" },
      { "node": "line", "port": "rois", "hint": "定位给出的角色框" },
      { "node": "ref", "port": "scan", "hint": "定位之后的剖面对" },
      { "node": "ref", "port": "rois", "hint": "定位给出的角色框" }
    ],
    "outputs": [
      { "node": "flush", "port": "value", "hint": "段差读数（毫米）" },
      { "node": "judge", "port": "value", "hint": "带判定的段差" }
    ]
  }
}
