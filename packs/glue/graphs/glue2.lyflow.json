{
  "schemaVersion": 1,
  "id": "01JGLUE00000000000000GLUE2",
  "name": "涂胶检测 · 螺旋胶（演示数据 Glue2）",
  "meta": {
    "app": "lyflow/0.1.0",
    "note": "海康三目演示图 Glue2（螺旋胶，有弯道）的参数：喷嘴 (712, 598)，扇区 −130°…−10°，检测区 s ∈ [150, 400]（螺旋胶在喷嘴附近更乱，检测区起点再往外挪 50 px），胶宽取外包络。读图节点是 source=inputs（宿主逐帧注入 n_load.image）。拿文件跑：lyflow run <图> --input n_load.image=<帧>，或 lyflow eval <图> --set n_load.source='\"file\"' --samples-glob \"<目录>/Frame*_1.jpg\" --bind n_load.path；packs/glue/tools/ 下的脚本就是这么跑的（数据目录由 LYFLOW_GLUE_DATA 给，真实帧不进仓库）。"
  },
  "nodes": [
    {
      "id": "n_load",
      "op": "io.load_image",
      "opVersion": "1.0.0",
      "params": {
        "source": "inputs"
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 0
        },
        "title": "读图"
      }
    },
    {
      "id": "n_path",
      "op": "glue.bead_path",
      "opVersion": "1.0.0",
      "params": {
        "nozzle": [
          712,
          598
        ],
        "zone": [
          150,
          400
        ],
        "sector": [
          -130,
          -10
        ]
      },
      "ui": {
        "position": {
          "x": 260,
          "y": 0
        },
        "title": "定胶路"
      }
    },
    {
      "id": "n_width",
      "op": "glue.bead_width",
      "opVersion": "1.0.0",
      "params": {
        "form": "swirl"
      },
      "ui": {
        "position": {
          "x": 520,
          "y": 0
        },
        "title": "量胶宽"
      }
    },
    {
      "id": "n_breaks",
      "op": "glue.bead_breaks",
      "opVersion": "1.0.0",
      "params": {
        "minLength": 20
