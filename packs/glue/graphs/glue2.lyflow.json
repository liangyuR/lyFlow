      "params": {
        "searchLength": 200
      },
      "ui": {
        "position": {
          "x": 780,
          "y": 110
        },
        "title": "量边距"
      }
    },
    {
      "id": "n_judge",
      "op": "glue.judge",
      "opVersion": "1.0.0",
      "params": {
        "maxBreak": 0,
        "minDefectLength": 20
      },
      "ui": {
        "position": {
          "x": 1040,
          "y": 0
        },
        "title": "判定"
      }
    }
  ],
