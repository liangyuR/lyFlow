{
  "schemaVersion": 1,
  "id": "01JGLUE0000000000000COLOR1",
  "name": "涂胶测量 · 彩色胶条（1.3 彩色测量算子示例）",
  "meta": {
    "app": "lyflow/1.3.0",
    "note": "docs/glue-measure-ops.md「1.3 彩色测量算子」的参考连法。示教：示教帧 + 示教线 → glue.color_model 出颜色模型（宿主把 n_model.model 的 JSON 存进配方）。生产：glue.color_map 打一次分（maps 一条线接给下游），沿示教线布彩色卡尺，或扇形扫描 → 彩色粗跟踪 → 彩色卡尺。宿主生产时不带 n_teach / n_model，把配方里的模型 JSON 填进 n_map.model 参数。判定（有无胶、无信息的站算不算、断胶）归宿主。拿文件跑：lyflow run <图> --set n_teach.source='\"file\"' --set n_teach.path='\"<示教帧>\"' --set n_load.source='\"file\"' --set n_load.path='\"<帧>\"' --param points='\"[[640,900],[640,300]]\"' --outputs。"
  },
  "params": {
    "points": {
      "type": "text",
      "label": "示教线",
      "doc": "沿胶中心画的示教线：JSON 数组 [[x, y], …]（图像像素），至少两个点。",
      "default": "[[640, 900], [640, 300]]",
      "binds": [
        "n_line.points"
      ],
      "rows": 4
    },
    "roi": {
      "type": "vec4f",
      "label": "打分区域",
      "unit": "px",
      "default": [
        0,
        0,
        0,
        0
      ],
      "binds": [
        "n_map.roi"
      ]
    },
    "anchor": {
      "type": "vec2f",
      "label": "出胶点",
      "unit": "px",
      "default": [
        640,
        900
      ],
      "binds": [
        "n_fan.anchor",
        "n_track.anchor"
      ]
    },
    "sector": {
      "type": "vec2f",
      "label": "方向范围",
      "unit": "deg",
      "default": [
        -120,
        -60
      ],
      "binds": [
        "n_fan.sector",
        "n_track.bearingRange"
      ]
    },
    "zone": {
      "type": "vec2f",
      "label": "检测区",
      "unit": "px",
      "default": [
        100,
        400
      ],
      "binds": [
        "n_track.zone"
      ]
    }
  },
