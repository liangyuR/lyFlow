{
  "schemaVersion": 1,
  "id": "01JGLUE00000000000FLYSHOT01",
  "name": "涂胶飞拍 · 定位 + 逐点卡尺（ly-TuJiaoVision）",
  "meta": {
    "app": "lyflow/0.1.0",
    "note": "固定相机飞拍后检（glue-plan §5）的产线图。宿主逐帧注入 n_load.image，并经顶层参数给这一帧（拍照点 k）的模板、模板锚点、测量点文件与工位标定文件；图只量不判，判定与断胶的跨帧合并在宿主。拿文件跑：lyflow run <图> --set n_load.source='\"file\"' --set n_load.path='\"<帧>\"' --param template='\"k0.png\"' --param anchor='[590,250]' --param stations='\"k0.stations.json\"' --param calib='\"plane_calib.json\"'。"
  },
  "nodes": [
    {
      "id": "n_load",
      "op": "io.load_image",
      "opVersion": "1.0.0",
      "params": {
        "source": "inputs"
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 0
        },
        "title": "读图"
      }
    },
    {
      "id": "n_calib",
      "op": "image.load_calib",
      "opVersion": "1.0.0",
      "params": {},
      "ui": {
        "position": {
          "x": 0,
          "y": 160
        },
        "title": "工位标定"
      }
    },
    {
      "id": "n_locate",
      "op": "glue.locate",
      "opVersion": "1.0.0",
      "params": {},
      "ui": {
        "position": {
          "x": 260,
          "y": 0
        },
        "title": "定位"
      }
    },
    {
      "id": "n_calipers",
      "op": "glue.station_calipers",
      "opVersion": "1.0.0",
      "params": {},
      "ui": {
        "position": {
          "x": 520,
          "y": 60
        },
        "title": "逐点卡尺"
      }
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": {
        "node": "n_load",
        "port": "image"
      },
      "to": {
        "node": "n_locate",
        "port": "image"
      }
    },
    {
      "id": "e1",
      "from": {
        "node": "n_load",
        "port": "image"
      },
      "to": {
        "node": "n_calipers",
        "port": "image"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "n_locate",
        "port": "pose"
      },
      "to": {
        "node": "n_calipers",
        "port": "pose"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "n_calib",
        "port": "calib"
      },
      "to": {
        "node": "n_calipers",
        "port": "calib"
      }
    }
  ],
  "outputs": {
    "pose": {
      "node": "n_locate",
      "port": "pose",
      "label": "位姿"
    },
    "measure": {
      "node": "n_calipers",
      "port": "measure",
      "label": "逐点测量"
    },
    "coverage": {
      "node": "n_calipers",
      "port": "coverage",
      "label": "量成占比"
    },
    "overlay": {
      "node": "n_calipers",
      "port": "overlay",
      "label": "卡尺叠画"
    },
    "locateOverlay": {
      "node": "n_locate",
      "port": "overlay",
      "label": "定位叠画"
    }
  },
  "params": {
    "template": {
      "type": "path",
      "label": "模板",
      "doc": "这一帧（拍照点 k）的定位模板，示教时从示教图上裁下。",
      "default": "",
      "binds": [
        "n_locate.template"
      ],
      "mode": "open"
    },
    "anchor": {
      "type": "vec2f",
      "label": "模板锚点",
      "doc": "模板左上角在示教图上的位置（px）。",
      "default": [
        0,
        0
      ],
      "binds": [
        "n_locate.anchor"
      ],
      "unit": "px",
      "componentLabels": [
        "X",
        "Y"
      ]
    },
    "stations": {
      "type": "path",
      "label": "测量点",
      "doc": "这一帧负责的测量点文件（示教图坐标）。",
      "default": "",
      "binds": [
        "n_calipers.stations"
      ],
      "mode": "open"
    },
    "calib": {
      "type": "path",
      "label": "工位标定",
      "doc": "image.PlaneCalib 的 JSON 文件；标定属于相机工位。",
      "default": "",
      "binds": [
        "n_calib.path"
      ],
      "mode": "open"
    }
  }
}
