    },
    "trackWidthMax": {
      "type": "float",
      "label": "跟踪胶宽上限",
      "unit": "px",
      "default": 90,
      "binds": [
        "n_t0.widthMax",
        "n_t0.searchHalf",
        "n_t0.mergeWidthMax",
        "n_t1.widthMax",
        "n_t1.searchHalf",
        "n_t1.mergeWidthMax",
        "n_t2.widthMax",
        "n_t2.searchHalf",
        "n_t2.mergeWidthMax"
      ]
    },
    "stationStep": {
      "type": "float",
      "label": "站距",
      "unit": "px",
      "default": 4,
      "binds": [
        "n_r0.stationStep",
        "n_r1.stationStep",
        "n_r2.stationStep"
      ]
    },
    "searchHalf": {
      "type": "float",
      "label": "卡尺半长",
      "unit": "px",
      "default": 60,
      "binds": [
        "n_r0.searchHalf",
        "n_r1.searchHalf",
        "n_r2.searchHalf"
      ]
    },
    "split": {
      "type": "enum",
      "label": "拆分方式",
      "default": "half_max",
      "options": [
        {
          "value": "half_max",
          "label": "半高拆分"
        },
        {
          "value": "connected",
          "label": "连通段"
        }
      ],
      "binds": [
        "n_r0.split",
        "n_r1.split",
        "n_r2.split"
      ]
    },
    "segmentMin": {
      "type": "float",
      "label": "分段门限",
      "default": 8,
