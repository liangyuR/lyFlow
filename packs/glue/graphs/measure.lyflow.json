      "binds": [
        "n_t0.zone",
        "n_t1.zone",
        "n_t2.zone"
      ]
    },
    "polarity": {
      "type": "enum",
      "label": "极性",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "暗胶"
        },
        {
          "value": "bright",
          "label": "亮胶"
        }
      ],
      "binds": [
        "n_resp.polarity"
