{
  "schemaVersion": 1,
  "id": "01JGLUE00000000000MEASURE1",
  "name": "涂胶测量 · 逐帧定向（1.2 测量算子示例）",
  "meta": {
    "app": "lyflow/1.2.0",
    "note": "docs/glue-measure-ops.md 的参考连法：响应图只算一次，扇形扫描取前三个峰，每个峰各跟踪、拟合一条胶路并沿它布横向卡尺，一次运行算完全部候选；判定（覆盖率、陡度、选哪个候选、每站取哪一段）归宿主。宿主逐帧注入 n_load.image，顶层参数逐相机 / 段给。拿文件跑：lyflow run <图> --set n_load.source='\"file\"' --set n_load.path='\"<帧>\"' --param anchor='[629.1,890.7]' --param sector='[-146.44,-116.44]' --param zone='[0,300]' --outputs。"
  },
  "params": {
    "anchor": {
      "type": "vec2f",
      "label": "出胶点",
      "unit": "px",
      "default": [
        640,
        512
      ],
      "binds": [
        "n_fan.anchor",
        "n_t0.anchor",
        "n_t1.anchor",
        "n_t2.anchor"
      ]
    },
    "sector": {
      "type": "vec2f",
      "label": "方向范围",
      "unit": "deg",
      "default": [
        -180,
        180
      ],
      "binds": [
        "n_fan.sector",
        "n_t0.bearingRange",
        "n_t1.bearingRange",
        "n_t2.bearingRange"
      ]
    },
    "radial": {
      "type": "vec2f",
      "label": "扇形径向区间",
      "unit": "px",
      "default": [
        100,
        250
      ],
      "binds": [
        "n_fan.radial"
      ]
    },
    "zone": {
      "type": "vec2f",
      "label": "检测区",
      "unit": "px",
      "default": [
        100,
        400
