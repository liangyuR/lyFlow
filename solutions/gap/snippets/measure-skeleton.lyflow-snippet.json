{
  "schemaVersion": 1,
  "id": "gap.measure_skeleton",
  "label": "测点骨架",
  "category": "间隙",
  "doc": "一个测点在定位之后的全部步骤：段差（基准线 + 线端点参考点）、间隙（缝两侧圆）、两个判定与结果汇总。插在定位节点后面，scan 与 rois 自动接到它唯一的那一对输出上。",
  "nodes": [
    {
      "id": "line",
      "op": "gap.role_line",
      "params": {
        "role": "datum"
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 0
        },
        "title": "基准线"
      },
      "opVersion": "3.0.0"
    },
    {
      "id": "ref",
      "op": "gap.ref_point",
      "params": {
        "method": "line_end",
        "role": "target"
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 190
        },
        "title": "参考点"
      },
      "opVersion": "3.0.0"
    },
    {
      "id": "flush",
      "op": "metrology.flush_point_line",
      "ui": {
        "position": {
          "x": 260,
          "y": 90
        },
        "title": "段差"
      },
      "params": {
        "signed": true,
        "signConvention": "canonical_axis",
        "gain": 1.0,
        "offsetMm": 0.0,
        "outputUnit": "mm"
      },
      "opVersion": "2.0.1"
    },
    {
      "id": "judgeFlushTolerance",
      "op": "metrology.compare_tolerance",
      "ui": {
        "position": {
          "x": 500,
          "y": 0
        },
        "title": "比较段差"
      },
      "opVersion": "1.0.0"
    },
    {
      "id": "judgeFlush",
      "op": "gap.apply_patrol",
      "ui": {
        "position": {
          "x": 760,
          "y": 0
        },
        "title": "判定段差"
      },
      "opVersion": "1.0.0"
    },
    {
      "id": "circles",
      "op": "gap.seam_circles",
      "ui": {
        "position": {
          "x": 0,
          "y": 380
        },
        "title": "缝两侧圆"
      },
      "opVersion": "3.0.0"
    },
    {
      "id": "gap",
      "op": "metrology.circle_gap",
      "ui": {
        "position": {
          "x": 260,
          "y": 380
        },
        "title": "间隙"
      },
      "params": {
        "definition": "center_line",
        "offsetMm": 0.0,
        "outputUnit": "mm"
      },
      "opVersion": "2.0.0"
    },
    {
      "id": "judgeGapTolerance",
      "op": "metrology.compare_tolerance",
      "ui": {
        "position": {
          "x": 500,
          "y": 380
        },
        "title": "比较间隙"
      },
      "opVersion": "1.0.0"
    },
    {
      "id": "judgeGap",
      "op": "gap.apply_patrol",
      "ui": {
        "position": {
          "x": 760,
          "y": 380
        },
        "title": "判定间隙"
      },
      "opVersion": "1.0.0"
    },
    {
      "id": "bundle",
      "op": "gap.result_bundle",
      "ui": {
        "position": {
          "x": 500,
          "y": 170
        },
        "title": "结果汇总"
      },
      "opVersion": "4.0.0"
    }
  ],
