{
  "schemaVersion": 1,
  "id": "gap.flush_line_end",
  "label": "段差 · 线端点",
  "category": "间隙",
  "doc": "基准面拟一条线、参考面拟一条线取靠缝那一端，量两者的段差并判定。接在定位节点（gap.locate_template / gap.locate_model）的 rois 与 scan 后面。",
  "nodes": [
    {
      "id": "line",
      "op": "gap.role_line",
      "params": {
        "role": "datum"
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 0
        },
        "title": "基准线"
      },
      "opVersion": "3.0.0"
    },
    {
      "id": "ref",
      "op": "gap.ref_point",
      "params": {
        "method": "line_end",
        "role": "target"
      },
      "ui": {
        "position": {
          "x": 0,
          "y": 190
        },
        "title": "参考点"
      },
      "opVersion": "3.0.0"
    },
    {
      "id": "flush",
      "op": "metrology.flush_point_line",
      "ui": {
        "position": {
          "x": 260,
          "y": 90
        },
        "title": "段差"
      },
      "params": {
        "signed": true,
        "signConvention": "canonical_axis",
        "gain": 1.0,
        "offsetMm": 0.0,
        "outputUnit": "mm"
      },
      "opVersion": "2.0.1"
    },
    {
      "id": "judge",
      "op": "gap.judge",
      "ui": {
        "position": {
          "x": 500,
          "y": 90
        },
        "title": "判定段差"
      },
      "opVersion": "1.0.0"
    }
  ],
  "edges": [
    {
      "from": {
        "node": "line",
        "port": "line"
      },
      "to": {
        "node": "flush",
        "port": "baseLine"
      }
    },
    {
      "from": {
        "node": "ref",
        "port": "point"
      },
      "to": {
        "node": "flush",
        "port": "refPoint"
      }
    },
    {
      "from": {
        "node": "flush",
        "port": "value"
      },
      "to": {
        "node": "judge",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "line",
        "port": "lineContext"
      },
      "to": {
        "node": "flush",
        "port": "baseLineContext"
      }
    },
    {
      "from": {
        "node": "ref",
        "port": "pointContext"
      },
      "to": {
        "node": "flush",
        "port": "refPointContext"
      }
    }
  ],
  "ports": {
    "inputs": [
      {
        "node": "line",
        "port": "scan",
        "hint": "定位之后的剖面对"
      },
      {
        "node": "line",
        "port": "rois",
        "hint": "定位给出的角色框"
      },
      {
        "node": "ref",
        "port": "scan",
        "hint": "定位之后的剖面对"
      },
      {
        "node": "ref",
        "port": "rois",
        "hint": "定位给出的角色框"
      }
    ],
    "outputs": [
      {
        "node": "flush",
        "port": "value",
        "hint": "段差读数（毫米）"
      },
      {
        "node": "judge",
        "port": "value",
        "hint": "带判定的段差"
      }
    ]
  }
}
